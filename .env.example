# EduToon AI — example environment
#
# No real secrets in this file. It ships values for the local Docker stack only.
# Copy it to .env for local development: `cp .env.example .env`
# Never commit .env — it is git-ignored.

# --- Required -------------------------------------------------------------------
ENVIRONMENT=development
# Postgres is published on host port 5433 (see docker-compose.yml) to avoid
# clashing with a native PostgreSQL install on 5432.
DATABASE_URL=postgresql+asyncpg://edutoon:edutoon@localhost:5433/edutoon
DATABASE_DIRECT_URL=postgresql+asyncpg://edutoon:edutoon@localhost:5433/edutoon
REDIS_URL=redis://localhost:6379/0
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY_ID=edutoon
STORAGE_SECRET_ACCESS_KEY=edutoon123
BUCKET_UPLOADS=edutoon-uploads
BUCKET_ASSETS=edutoon-assets
BUCKET_SEGMENTS=edutoon-segments
BUCKET_OUTPUTS=edutoon-outputs
# Clerk (Configure > API Keys in your Clerk dashboard - see apps/api/README.md
# "Clerk Local Setup" for the full walkthrough). Both are derived from your
# Clerk instance's Frontend API URL, not a secret key - safe to keep in this
# example file as a placeholder shape.
CLERK_ISSUER=https://your-app-name-12.clerk.accounts.dev
CLERK_JWKS_URL=https://your-app-name-12.clerk.accounts.dev/.well-known/jwks.json
# Used by providers/embeddings.py (Evidence Engine). Real secret - get one
# from https://platform.openai.com/api-keys.
OPENAI_API_KEY=sk-your-openai-api-key
# Used by providers/llm.py (Evidence Engine). Real secret - get one from
# https://console.anthropic.com/settings/keys.
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# --- Optional (defaults shown) -------------------------------------------------
LOG_LEVEL=INFO
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
MAX_UPLOAD_BYTES=104857600
# Roles and invitations (apps/api/README.md "Roles, invitations and sign-in"). Nobody becomes a
# user by signing in. ADMIN_BOOTSTRAP_EMAILS (comma-separated) names who may become the FIRST
# administrator, and which existing users the migration promotes; empty it once one exists.
ADMIN_BOOTSTRAP_EMAILS=
# Only to ask Clerk to email an invitation (a real secret - never commit it). Empty: the invitation
# is still recorded and the administrator passes the sign-up link on.
CLERK_SECRET_KEY=
CLERK_API_BASE_URL=https://api.clerk.com
CLERK_INVITATION_REDIRECT_URL=
INVITATION_TTL_DAYS=7
MAX_PDF_PAGES=300
# Scanned or image-only PDF pages are read by local OCR (RapidOCR; nothing leaves the machine). A PDF
# is read this way only when at most OCR_MAX_PAGES of its pages need it (about 5 seconds a page);
# a longer scan is refused with a message, never half-read. OCR_RENDER_SCALE is how large a page is
# drawn for recognition (1.0 = 72 dpi).
OCR_ENABLED=True
OCR_MAX_PAGES=30
OCR_RENDER_SCALE=2.0
MAX_DECK_SLIDES=100

# Topic-only projects (a topic with no document): the lesson is written from the model's general
# knowledge, labelled as unchecked, and the video says so in its first sentence. Set false to refuse
# the mode. PDF projects with keywords are unaffected either way.
KEYWORD_ONLY_PROJECTS_ENABLED=True
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=claude-sonnet-5

# Provider calls. PROVIDER_RETRY_* is the one policy for repeating a call that failed
# transiently (a rate limit, a timeout, a dropped connection, a 5xx): ATTEMPTS counts the
# first try (1 disables retrying) and the wait doubles from BASE up to MAX seconds. A bad
# request, a rejected key or an exhausted quota is never retried. LLM_THINKING is how extended
# thinking is configured on every Anthropic request: "disabled" (required for a forced tool
# call on claude-sonnet-5) or "omit" (leave the parameter out, for a model that rejects a
# disabled value). LLM_TIMEOUT_SECONDS bounds one attempt. EMBEDDING_MAX_* are the size of one
# embeddings request; the defaults are the provider's own hard ceilings - lower, never higher.
# Before any real-provider testing, set a monthly spend limit in the OpenAI and Anthropic
# consoles: the application has an in-process guard (MAX_PROVIDER_CALLS_*) but no billing.
# MAX_PROVIDER_CALLS_PER_JOB is a tripwire against a runaway loop (a job that reaches it stops
# before its next call), not a budget. The two per-hour limits bound how many paid jobs, and how
# many hand-typed claim verifications, one project may start in an hour; both answer 429.
MAX_PROVIDER_CALLS_PER_JOB=2000
MAX_PROVIDER_JOBS_PER_PROJECT_PER_HOUR=30
MAX_MANUAL_CLAIM_VERIFICATIONS_PER_PROJECT_PER_HOUR=120
PROVIDER_RETRY_ATTEMPTS=3
PROVIDER_RETRY_BASE_DELAY_SECONDS=2.0
PROVIDER_RETRY_MAX_DELAY_SECONDS=30.0
LLM_THINKING=disabled
LLM_TIMEOUT_SECONDS=300.0
EMBEDDING_MAX_INPUTS_PER_REQUEST=2048

# Script checks. SCRIPT_SUPPORT_CHECK_ENABLED judges every script sentence against the verified claims
# it may rest on (one or two model calls per sentence - minutes per script); a sentence no claim
# supports is rewritten once, then removed. SCRIPT_FALLBACK_TO_CLAIMS reads a topic's own verified
# claims out when its wording cannot be supported at all, instead of failing the whole script.
SCRIPT_SUPPORT_CHECK_ENABLED=True
SCRIPT_FALLBACK_TO_CLAIMS=True
# A scene whose text the narration does not contain, after rewrites, becomes a bullet scene of the
# narration's own words instead of leaving the segment without scenes.
STORYBOARD_FALLBACK_TO_TEXT=True
EMBEDDING_MAX_REQUEST_TOKENS=300000

# Free, local AI (apps/api/README.md "Local AI backend"). AI_BACKEND=cloud uses Anthropic and
# OpenAI as above. AI_BACKEND=local uses an Ollama server instead - no key, no cost, nothing sent
# off the machine - and then LLM_MODEL, SCRIPT_LLM_MODEL and EMBEDDING_MODEL are Ollama model names
# (use the same model for the first two). The two API keys above stay required settings, but a
# local backend never uses them: leave the placeholders. OLLAMA_NUM_CTX is the context window asked
# of every call (a call whose prompt fills it fails rather than being silently cut short).
# OLLAMA_DISABLE_THINKING=True is only for a model that thinks by default (such as qwen3).
# EMBEDDING_MAX_INPUT_TOKENS is the largest single embedding input, as a byte-length bound.
AI_BACKEND=cloud
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_CTX=16384
OLLAMA_TIMEOUT_SECONDS=900.0
OLLAMA_DISABLE_THINKING=False
EMBEDDING_MAX_INPUT_TOKENS=8192

# Script generation. SCRIPT_LLM_MODEL is the model that writes scripts (the worker
# builds a second client bound to it); claim judging and topic extraction keep using
# LLM_MODEL. The two may differ, and each script records the model that actually
# wrote it. The two caps bound the size and cost of one generation; the
# words-per-minute rate turns a segment's word count into its estimated spoken
# length.
SCRIPT_LLM_MODEL=claude-sonnet-5
MAX_SCRIPT_SEGMENTS=12
MAX_CLAIMS_PER_GENERATION=40
SCRIPT_WORDS_PER_MINUTE=150
# The pace a PowerPoint deck lesson is planned at: about the pace of the Piper voice above (measured
# 163 on a real deck lesson, 132 on a longer-worded sample). The measured narration replaces it.
DECK_SPEECH_WORDS_PER_MINUTE=160

# The evidence-per-minute guard: the most narration, in seconds, one supported claim may carry. A
# script whose target is longer than its verified claims can honestly fill at this rate is refused
# before any paid call. Re-tune against real-provider results, never to make an unsupported
# target pass.
EVIDENCE_SECONDS_PER_CLAIM=30

# Topic extraction (Phase 5). All optional - leave them out to use the defaults.
# How much of the uploaded material one extraction may show the model, in
# characters (about 4 per token, so 48000 is roughly 12k input tokens). This is
# the main cost control: a longer document is sampled evenly across its whole
# length and the job result reports `truncated`.
TOPIC_INPUT_BUDGET_CHARS=48000
# The most topics one extraction may return, and also the most topics of their
# own (keywords) a user may add to a project.
MAX_TOPICS_PER_EXTRACTION=30
# Levels in the topic tree: 3 means topics, subtopics and sub-subtopics.
MAX_TOPIC_DEPTH=3
MAX_TOPIC_TITLE_CHARS=120
MAX_TOPIC_SUMMARY_CHARS=400
# Key terms per topic, and the longest one.
MAX_TOPIC_KEYWORDS=8
MAX_TOPIC_KEYWORD_CHARS=40
# Source passages a single topic may cite.
MAX_TOPIC_EVIDENCE=6
# How long an extraction may sit "running" before it is treated as abandoned by a
# crashed worker and failed, so it stops blocking the project. A job a live worker
# is running is never failed by this (the worker holds its row lock), so it is a
# backstop: keep it above the longest a model call can take (about 30 minutes with
# the Anthropic SDK's default timeout and retries). Minimum 60.
TOPIC_EXTRACTION_STALE_AFTER_SECONDS=3600

# Candidate claim extraction (Phase 6). All optional - leave them out to use the
# defaults. How much of one topic's own cited material one extraction call may
# show the model, in characters - far smaller than TOPIC_INPUT_BUDGET_CHARS
# since it is per topic, not per document.
CLAIM_INPUT_BUDGET_CHARS=12000
# The most candidate claims one topic's extraction may propose.
MAX_CLAIMS_PER_TOPIC=10
MAX_CLAIM_TEXT_CHARS=300
# Mirrors TOPIC_EXTRACTION_STALE_AFTER_SECONDS: how long an extract_claims job
# may sit "running" before it is treated as abandoned by a crashed worker and
# failed. Minimum 60.
CLAIM_EXTRACTION_STALE_AFTER_SECONDS=3600

# Duration-aware, topic-scoped script generation (Phase 7). All optional - leave
# them out to use the defaults. MIN_SECTION_DURATION_MS is the floor every
# accepted topic's section gets (and the enqueue-time check that a project has
# not accepted more topics than its target duration can give each a floor).
# MAX_SECTION_DURATION_MS is a per-call ceiling, not a cap on a topic's total
# budget: a topic allocated more than this is split into several ordered
# sub-sections instead of one huge call.
MIN_SECTION_DURATION_MS=30000
MAX_SECTION_DURATION_MS=300000
# How many accepted topics one generation may cover - enforced at enqueue time.
MAX_SCRIPT_SECTIONS=20
# How many of a topic's own supported claims one section's call may see.
MAX_CLAIMS_PER_SECTION=15
# How far the WPM-based estimate may sit from the project's target duration (a
# fraction of the target) before one bounded correction pass re-generates every
# section with a rescaled word budget. The script is accepted after that pass
# regardless of the result - duration is a target, never a hard gate.
SCRIPT_DURATION_TOLERANCE=0.15
# How many bounded correction passes a generation may run when outside
# tolerance - 0 disables correction outright. No automatic retry beyond this.
MAX_SCRIPT_CORRECTION_ATTEMPTS=1
# How much bounded continuity context (previous/next section) a section's
# prompt may carry, in characters.
CONTINUITY_CONTEXT_CHARS=600
# How long a generate_script job may sit "running" before it is treated as
# abandoned by a crashed worker and failed (mirrors the topic/claim extraction
# stale settings above). Minimum 60.
SCRIPT_GENERATION_STALE_AFTER_SECONDS=3600

# Local narration synthesis with Piper (Phase 8). All optional - leave them out to use
# the defaults. Entirely local and free to run; no company API key needed. Download
# voice files first: `make voices` (or scripts/download_piper_voices.py).
PIPER_VOICES_DIR=var/piper-voices
# Piper has no genuine Indian-English voice. PIPER_VOICE_EN_IN is deliberately the
# same catalogue id as PIPER_VOICE_EN_GB by default; PIPER_EN_IN_IS_TEMPORARY_SUBSTITUTE
# records that explicitly so it is never silently presented as Indian English. See
# apps/api/README.md, "Text-to-speech".
PIPER_VOICE_EN_GB=en_GB-cori-medium
PIPER_VOICE_EN_IN=en_GB-cori-medium
PIPER_EN_IN_IS_TEMPORARY_SUBSTITUTE=True
# How Piper speaks. These are the voice's trained values; change them only after listening, and
# expect narration to be re-made when you do.
PIPER_LENGTH_SCALE=1.0
PIPER_NOISE_SCALE=0.667
PIPER_NOISE_W_SCALE=0.8
# Safety caps on one synthesis job - generous defaults, never required to bind.
MAX_TTS_CHARS_PER_CALL=1000
MAX_TTS_CHARS_PER_SEGMENT=8000
MAX_TTS_CHARS_PER_SCRIPT=200000
MAX_CONCURRENT_TTS=1
TTS_SEGMENT_TIMEOUT_SECONDS=120
# Mirrors the other STALE_AFTER_SECONDS settings above. Minimum 60.
SYNTHESIS_STALE_AFTER_SECONDS=3600

# The same, for a build_evidence (indexing) job. Measured from the job's last sign of life, so a job
# that keeps reporting progress is never reclaimed however long it runs. Minimum 60.
INDEXING_STALE_AFTER_SECONDS=3600

# Scene / Storyboard layer (Phase 9). All optional - leave them out to use the
# defaults. Turns each segment's measured narration audio into an ordered set of
# fixed-template scenes; the six templates and their character limits are a fixed
# contract, not configuration. MIN_SCENE_DURATION_MS is the shortest a scene may
# run; MAX_SCENES_PER_SEGMENT caps one segment's single provider call.
MIN_SCENE_DURATION_MS=1500
MAX_SCENES_PER_SEGMENT=6
# Worst-case size bounds, enforced before any provider call. MAX_SCENES_PER_SCRIPT
# bounds a whole script; MAX_STORYBOARD_SEGMENTS bounds provider calls (one per
# segment, never one per scene).
MAX_SCENES_PER_SCRIPT=1200
MAX_STORYBOARD_SEGMENTS=200
# Mirrors the other STALE_AFTER_SECONDS settings above. Minimum 60.
STORYBOARD_STALE_AFTER_SECONDS=3600

# Video rendering (Phase 10). FFMPEG_BINARY / FFPROBE_BINARY are looked up on PATH unless a
# full path is given. RENDER_VIDEO_ENCODER is libx264 (software) or h264_nvenc (NVIDIA);
# H.264 / AAC patent licensing is a separate business decision the choice does not settle.
# MAX_RENDER_DURATION_MS is the longest video one render may produce (30 minutes).
# RENDER_WORK_DIR is scratch space ("" = the system temporary directory); a render is
# refused unless it has room for the estimate plus RENDER_MIN_FREE_DISK_MB.
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
RENDER_VIDEO_ENCODER=libx264
MAX_RENDER_DURATION_MS=1800000
RENDER_WORK_DIR=
RENDER_MIN_FREE_DISK_MB=1024
RENDER_CONCURRENCY=2
# Scene transitions (Phase 11): a straight cut between scenes of the same topic; a fade at a
# topic boundary and at the start and end of the video. Milliseconds, 0 to 1500 (0 = cut).
RENDER_FADE_IN_MS=240
RENDER_FADE_OUT_MS=200
RENDER_STALE_AFTER_SECONDS=3600
