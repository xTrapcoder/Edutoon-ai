# EduToon AI — example environment
#
# No real secrets in this file. It ships values for the local Docker stack only.
# Copy it to .env for local development: `cp .env.example .env`
# Never commit .env — it is git-ignored.

# --- Required -------------------------------------------------------------------
ENVIRONMENT=development
# Postgres is published on host port 5433 (see docker-compose.yml) to avoid
# clashing with a native PostgreSQL install on 5432.
DATABASE_URL=postgresql+asyncpg://edutoon:edutoon@localhost:5433/edutoon
DATABASE_DIRECT_URL=postgresql+asyncpg://edutoon:edutoon@localhost:5433/edutoon
REDIS_URL=redis://localhost:6379/0
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY_ID=edutoon
STORAGE_SECRET_ACCESS_KEY=edutoon123
BUCKET_UPLOADS=edutoon-uploads
BUCKET_ASSETS=edutoon-assets
BUCKET_SEGMENTS=edutoon-segments
BUCKET_OUTPUTS=edutoon-outputs
# Clerk (Configure > API Keys in your Clerk dashboard - see apps/api/README.md
# "Clerk Local Setup" for the full walkthrough). Both are derived from your
# Clerk instance's Frontend API URL, not a secret key - safe to keep in this
# example file as a placeholder shape.
CLERK_ISSUER=https://your-app-name-12.clerk.accounts.dev
CLERK_JWKS_URL=https://your-app-name-12.clerk.accounts.dev/.well-known/jwks.json
# Used by providers/embeddings.py (Evidence Engine). Real secret - get one
# from https://platform.openai.com/api-keys.
OPENAI_API_KEY=sk-your-openai-api-key
# Used by providers/llm.py (Evidence Engine). Real secret - get one from
# https://console.anthropic.com/settings/keys.
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# --- Optional (defaults shown) -------------------------------------------------
LOG_LEVEL=INFO
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
MAX_UPLOAD_BYTES=104857600
MAX_PDF_PAGES=300
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=claude-sonnet-5

# Script generation. The two caps bound the size and cost of one generation; the
# words-per-minute rate turns a segment's word count into its estimated spoken
# length. SCRIPT_LLM_MODEL is only the model name *recorded* on a script when it is
# queued: every model call - claim judging, topic extraction and script writing -
# uses LLM_MODEL, because the API and the worker each build a single client from
# it. Keep the two the same, or a script's recorded model will not be the one used.
SCRIPT_LLM_MODEL=claude-sonnet-5
MAX_SCRIPT_SEGMENTS=12
MAX_CLAIMS_PER_GENERATION=40
SCRIPT_WORDS_PER_MINUTE=150

# Topic extraction (Phase 5). All optional - leave them out to use the defaults.
# How much of the uploaded material one extraction may show the model, in
# characters (about 4 per token, so 48000 is roughly 12k input tokens). This is
# the main cost control: a longer document is sampled evenly across its whole
# length and the job result reports `truncated`.
TOPIC_INPUT_BUDGET_CHARS=48000
# The most topics one extraction may return, and also the most topics of their
# own (keywords) a user may add to a project.
MAX_TOPICS_PER_EXTRACTION=30
# Levels in the topic tree: 3 means topics, subtopics and sub-subtopics.
MAX_TOPIC_DEPTH=3
MAX_TOPIC_TITLE_CHARS=120
MAX_TOPIC_SUMMARY_CHARS=400
# Key terms per topic, and the longest one.
MAX_TOPIC_KEYWORDS=8
MAX_TOPIC_KEYWORD_CHARS=40
# Source passages a single topic may cite.
MAX_TOPIC_EVIDENCE=6
# How long an extraction may sit "running" before it is treated as abandoned by a
# crashed worker and failed, so it stops blocking the project. A job a live worker
# is running is never failed by this (the worker holds its row lock), so it is a
# backstop: keep it above the longest a model call can take (about 30 minutes with
# the Anthropic SDK's default timeout and retries). Minimum 60.
TOPIC_EXTRACTION_STALE_AFTER_SECONDS=3600
