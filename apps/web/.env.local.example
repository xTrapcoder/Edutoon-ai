# Copy to .env.local and fill in. Never commit .env.local.

# Where the API is running (`make dev` starts it on :8000).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Clerk. Create a development application at https://dashboard.clerk.com and copy the keys from
# Configure > API Keys. The API must be set up with the SAME Clerk instance (CLERK_ISSUER and
# CLERK_JWKS_URL in apps/api/.env), and its session token must carry an `email` claim - see
# "Clerk Local Setup" in apps/api/README.md.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Where Clerk sends people to sign in and sign up, and where they land afterwards.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Clerk can quietly create a temporary development instance when no keys are set ("keyless" mode).
# That instance is not the one the API trusts, so sign-in would appear to work and every API call
# would fail with 401. Keep it off: a missing key should be an obvious error.
NEXT_PUBLIC_CLERK_KEYLESS_DISABLED=1
