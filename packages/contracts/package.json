{
  "name": "@edutoon/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript types generated from the API's OpenAPI document. Never edit src/schema.d.ts by hand.",
  "main": "index.ts",
  "types": "index.ts",
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/schema.d.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.7.2"
  }
}
